# Copy this file to .env and replace placeholder values. Never commit .env.

# Web server
PORT=3000

# Application-level HTTP Basic Authentication. Set both values for browser UI
# access; setting only one makes protected routes fail closed.
SPENDEE_BASIC_AUTH_USERNAME=replace-with-a-username
SPENDEE_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password

# Required bearer key for every API endpoint, including health and readiness.
# Use a long random value. Browser UI requests are authenticated server-side and
# never expose this key to client JavaScript.
SPENDEE_API_KEY=replace-with-a-long-random-api-key

# Local metadata store. In Docker this is overridden to /data/spendee.db.
SQLITE_PATH=./data/spendee.db

# Actual Budget server and target budget
ACTUAL_SERVER_URL=https://actual.example.test
ACTUAL_SYNC_ID=replace-with-the-budget-sync-id

# Use exactly one authentication method. Password authentication is the
# simplest option for a self-hosted Actual server.
ACTUAL_PASSWORD=replace-with-the-server-password
# ACTUAL_SESSION_TOKEN=replace-with-a-session-token

# Optional for encrypted budgets. Leave empty for an unencrypted budget.
ACTUAL_BUDGET_ENCRYPTION_PASSWORD=

# Optional local Actual budget ID. The sync ID is used when this is omitted.
ACTUAL_BUDGET_ID=

# Actual's local cache must be persistent. Docker overrides this to /data/actual.
ACTUAL_DATA_DIR=./data/actual

# Persistent receipt uploads. Docker overrides this to /data/receipts.
RECEIPTS_DIR=./data/receipts

# Optional safety check. When empty, the app uses Actual's default currency.
ACTUAL_DEFAULT_CURRENCY=

# Optional snapshot cache lifetime in milliseconds.
ACTUAL_CACHE_TTL_MS=5000

# Optional transaction-validation integration.
OPENAI_API_KEY=
OPENAI_VALIDATION_MODEL=gpt-5.6-sol
OPENAI_RECEIPT_MODEL=gpt-5.6-sol
